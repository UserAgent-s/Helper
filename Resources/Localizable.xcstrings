          "stringUnit": {
            "state": "translated",
            "value": "Формат ключа виглядає некоректним (очікується sk-…)"
          }
        }
      }
    },
    "будет отправлен во внешний API. Продолжить?": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "будет отправлен во внешний API. Продолжить?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "will be sent to an external API. Continue?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "буде надіслано до зовнішнього API. Продовжити?"
          }
        }
      }
    },
    "Микрофон нужен только для recording; answers работает без него, если выбран системный источник.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон нужен только для recording; answers работает без него, если выбран системный источник."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is only needed for recording; answers works without it if a system source is selected."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон потрібен лише для recording; answers працює без нього, якщо обрано системне джерело."
          }
        }
      }
    },

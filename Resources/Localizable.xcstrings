          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain already holds a different OpenAI key; it is used. The old value in settings was not deleted."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Keychain уже є інший ключ OpenAI; використовується він. Старе значення з налаштувань не видалено."
          }
        }
      }
    },
    "Включать текст вопросов, ответов и транскрипты в файл диагностики": {

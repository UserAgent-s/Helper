      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено по умолчанию. При включении системный звук и микрофон записи сохраняются как WAV-файлы отдельно для каждой встречи."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. When enabled, system audio and microphone are saved as separate WAV files for each meeting."
